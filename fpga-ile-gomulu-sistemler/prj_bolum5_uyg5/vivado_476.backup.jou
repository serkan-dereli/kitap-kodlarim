start_gui
open_project {E:/bildiri ve makaleler/kitap/fpga/uygulamalar/prj_bolum5_uyg5/prj_bolum5_uyg5.xpr}
update_compile_order -fileset sources_1
launch_simulation
source uyg55.tcl
add_force {/uyg55/clk} -radix hex {0 0ns} {1 50000ps} -repeat_every 100000ps
add_force {/uyg55/rst} -radix hex {0 0ns}
add_force {/uyg55/sec} -radix hex {1 0ns}
add_force {/uyg55/sayi1} -radix hex {c 0ns}
add_force {/uyg55/sayi2} -radix hex {6 0ns}
run 100 ns
add_force {/uyg55/sec} -radix hex {2 0ns}
run 100 ns
add_force {/uyg55/sec} -radix hex {3 0ns}
run 100 ns
synth_design -rtl -name rtl_1
